# Synapse — environment template
# Copy to .env and fill in real values. Never commit .env.

# Neon Postgres connection string (use the POOLED host for serverless).
# Get it from https://console.neon.tech -> your project -> Connection Details
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?channel_binding=require&sslmode=require

# Public base URL used by the browser client
NEXT_PUBLIC_APP_URL=http://localhost:3000
