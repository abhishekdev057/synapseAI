<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Synapse" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/synapse_bg_light</item>
        <item name="android:statusBarColor">@color/synapse_bg_light</item>
        <item name="android:navigationBarColor">@color/synapse_bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.Synapse.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/synapse_icon_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/synapse_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Synapse</item>
    </style>

</resources>
